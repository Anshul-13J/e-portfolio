---
import "../styles/global.css";
import { achievements } from "../data/achievements.config";
import { projects } from "../data/projects.config";
import { resumes } from "../data/resumes.config";

const currentResume = resumes[0];

const experience = [
  {
    date: "Jul 2024 to present",
    role: "Software Engineer, Data Analytics & AI",
    company: "Volkswagen Group Digital Solutions India",
    location: "Pune, India",
    details: [
      "Co-engineered AUDI AI-Factory with AUDI IT and Microsoft, scaling a production GenAI platform to 100,000+ active users.",
      "Built RAG pipelines and repeatable LLM evaluation using RAGAS, synthetic test sets, pytest and CI/CD.",
      "Developed a SharePoint MCP server and optimized HDBSCAN topic modeling to around 92% clustering accuracy.",
      "Replaced a Power BI workflow with Python and Streamlit, reducing dashboard operating costs by around 75%.",
    ],
  },
  {
    date: "Jan 2024 to Jun 2024",
    role: "Software Engineer Intern, FutureTech",
    company: "Volkswagen Group Digital Solutions India",
    location: "Pune, India",
    details: [
      "Developed production-ready MATTER-AI GraphRAG services with Python, Neo4j and Docker.",
      "Introduced exception handling and pytest coverage, reducing defect rates by around 20% and runtime failures by around 70%.",
    ],
  },
  {
    date: "Jun 2023 to Aug 2023",
    role: "Research Intern",
    company: "Ministry of Electronics and Information Technology",
    location: "Delhi-NCR, India",
    details: [
      "Analyzed 15+ Indian startup schemes and derived financial performance metrics for TIDE 2.0-funded fintech institutes.",
    ],
  },
];

const skills = [
  {
    label: "Generative AI",
    items: ["LLMs", "RAG", "Agentic AI", "LangChain", "LangGraph", "CrewAI", "MCP", "RAGAS"],
  },
  {
    label: "Search and machine learning",
    items: ["Azure AI Search", "Pinecone", "ChromaDB", "GraphRAG", "Neo4j", "Embeddings", "HDBSCAN"],
  },
  {
    label: "Engineering",
    items: ["Python", "FastAPI", "Streamlit", "PostgreSQL", "MongoDB", "pytest", "TDD"],
  },
  {
    label: "Cloud and delivery",
    items: ["Azure", "AWS", "Docker", "Kubernetes", "CI/CD", "GitHub Actions", "Azure DevOps"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Anshul Nigam is a software engineer focused on GenAI, RAG and agentic AI. Explore selected work, experience and skills."
    />
    <meta name="theme-color" content="#f4f3ee" />
    <title>Anshul Nigam | Software Engineer, GenAI & AI</title>
    <link rel="icon" type="image/png" href="/assets/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Anshul Nigam, home">
        <span class="wordmark-mark">AN</span>
        <span>Anshul Nigam</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle-label">Menu</span>
        <span class="menu-toggle-icon" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#resume">Resume</a>
        <a class="nav-contact" href="#contact">Contact me <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-wrap" id="home" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="availability-dot"></span> Software engineer · Pune, India</p>
          <h1 id="hero-title">Building AI that works <span>in the real world.</span></h1>
          <p class="hero-description">
            I build production GenAI, RAG and agentic systems, from the first useful prototype to platforms
            used at enterprise scale.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="/resume.pdf" target="_blank" rel="noreferrer">View resume <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-socials" aria-label="Social profiles">
            <a href="https://www.linkedin.com/in/anshul13j/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.5 9h3.4v11H3.5Zm5.5 0h3.3v1.5h.1a3.7 3.7 0 0 1 3.3-1.8c3.5 0 4.2 2.3 4.2 5.2V20h-3.4v-5.4c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V20H9Z" /></svg>
              <span>LinkedIn</span><span aria-hidden="true">↗</span>
            </a>
            <a href="https://github.com/Anshul-13J" target="_blank" rel="noreferrer" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1.8 2.4 3.9 1.8.1-.7.4-1.2.7-1.5-2.5-.3-5.2-1.3-5.2-5.6 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-3 0 0 .9-.3 3.1 1.1a10.8 10.8 0 0 1 5.6 0c2.2-1.4 3.1-1.1 3.1-1.1.6 1.6.2 2.7.1 3 .7.8 1.1 1.8 1.1 3 0 4.3-2.7 5.3-5.2 5.6.4.3.8 1 .8 2v3c0 .3.2.6.8.5A11.1 11.1 0 0 0 12 .9Z" /></svg>
              <span>GitHub</span><span aria-hidden="true">↗</span>
            </a>
            <a href="mailto:anshulnigam123@gmail.com" aria-label="Email Anshul">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 8.1L4.8 7H4v10h16V7h-.8L12 13.1Zm0-2.4L18.3 7H5.7l6.3 3.7Z" /></svg>
              <span>Email</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="portrait-frame">
            <img
              class="portrait"
              src="/assets/img/profile-img.jpg"
              alt="Portrait of Anshul Nigam"
              width="903"
              height="903"
              fetchpriority="high"
            />
            <span class="portrait-note">Curious by default.<br />Practical by design.</span>
          </div>
          <span class="hero-index" aria-hidden="true">01 / 04</span>
        </div>
      </section>

      <section class="work-section section-wrap section-block" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Selected work <span class="section-number">01</span></p>
            <h2 id="work-title">Projects with a point of view.</h2>
          </div>
          <p class="section-intro">A few problems I have worked on, and what changed because of it.</p>
        </div>
        <div class="filters" role="group" aria-label="Filter projects">
          <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">All work</button>
          <button class="filter-button" type="button" data-filter="genai" aria-pressed="false">GenAI</button>
          <button class="filter-button" type="button" data-filter="data" aria-pressed="false">Data & search</button>
          <button class="filter-button" type="button" data-filter="personal" aria-pressed="false">Personal projects</button>
          <button class="filter-button" type="button" data-filter="iot" aria-pressed="false">IoT</button>
        </div>
        <div class="project-carousel">
          <div class="project-controls" aria-label="Project carousel controls">
            <span class="project-position" aria-live="polite">01 / {String(projects.length).padStart(2, "0")}</span>
            <button class="project-arrow" type="button" data-project-prev aria-label="Previous projects" disabled>←</button>
            <button class="project-arrow" type="button" data-project-next aria-label="Next projects">→</button>
          </div>
          <div class="project-grid" id="project-grid" tabindex="0" aria-label="Featured projects">
          {projects.map((project, index) => (
            <article class="project-card" data-category={project.category} data-project-slug={project.slug} data-project-name={project.name.toLowerCase()}>
              <div class="project-card-top">
                <span class="project-number">{String(index + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</span>
                <span class="project-type">{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
              <ul class="impact-list">
                {project.impact.map((item) => <li>{item}</li>)}
              </ul>
              <div class="tag-list" aria-label="Technology used">
                {project.stack.map((item) => <span>{item}</span>)}
              </div>
              <a class="project-link" href={project.href} target={project.href.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer">
                {project.linkText} <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
          </div>
        </div>
        <p class="project-note">Some work was created with employer teams. Public details are limited to what has already been shared.</p>
      </section>

      <section class="about-section section-wrap section-block" id="about" aria-labelledby="about-title">
        <div class="about-copy">
          <p class="eyebrow">A little about me <span class="section-number">02</span></p>
          <h2 id="about-title">Good engineering makes complex things feel simple.</h2>
          <p>
            I am a software engineer in Volkswagen Group Digital Solutions India, working where applied
            AI meets dependable software. My focus is making language models useful through better retrieval,
            evaluation and thoughtfully designed agent workflows.
          </p>
          <p>
            I enjoy the full journey: understanding a real user problem, building the system around it, and
            measuring whether the result is actually better.
          </p>
          <p>
            I am curious by nature and enjoy exploring how new tools fit into real workflows. That curiosity
            keeps me learning, asking better questions and looking for simpler ways to solve hard problems.
          </p>
          <a class="text-link" href="https://www.linkedin.com/in/anshul13j/" target="_blank" rel="noreferrer">
            More on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="skills-panel">
          <p class="eyebrow">Tools I work with</p>
          {skills.map((group) => (
            <div class="skill-group">
              <h3>{group.label}</h3>
              <div class="tag-list">
                {group.items.map((item) => <span>{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="experience-section section-wrap section-block" id="experience" aria-labelledby="experience-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Experience <span class="section-number">03</span></p>
            <h2 id="experience-title">A path built around useful work.</h2>
          </div>
          <p class="section-intro">From applied research to shipping enterprise AI products.</p>
        </div>
        <div class="timeline">
          {experience.map((item, index) => (
            <article class="timeline-item">
              <div class="timeline-marker" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
              <div class="timeline-card">
                <p class="timeline-date">{item.date}</p>
                <div class="timeline-content">
                <h3>{item.role}</h3>
                <p class="timeline-company">{item.company} <span>{item.location}</span></p>
                <ul>
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="recognition">
          <p class="eyebrow">Recognition</p>
          {achievements.map((achievement, index) => (
            <article class="achievement-card">
              <span class="achievement-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{achievement.title}</h3>
              <p class="achievement-organization">{achievement.organization}</p>
              <p>{achievement.detail}</p>
            </article>
          ))}
        </div>
        <div class="education-block">
          <p class="eyebrow">Education</p>
          <div class="education-grid">
            <article class="education-card">
              <span class="education-level">Undergraduate · 2020 to 2024</span>
              <h3>B.Tech, Computer Science</h3>
              <p>KIET Group of Institutions (AKTU)</p>
              <span class="education-result">80.5%</span>
            </article>
            <article class="education-card">
              <span class="education-level">Intermediate (12th) · CBSE</span>
              <h3>Montfort Inter College</h3>
              <p>Lucknow · Physics, Chemistry and Mathematics</p>
              <span class="education-result">94.6%</span>
            </article>
          </div>
        </div>
      </section>

      <section class="resume-section section-wrap section-block" id="resume" aria-labelledby="resume-title">
        <div class="section-heading resume-heading">
          <div>
            <p class="eyebrow">The full story <span class="section-number">04</span></p>
            <h2 id="resume-title">Resume, ready when you are.</h2>
          </div>
          <div class="resume-actions">
            <a class="button button-dark" href={currentResume.file} target="_blank" rel="noreferrer">Open {currentResume.label} resume <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={currentResume.file} download>Download PDF <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="resume-viewer">
          <object data={currentResume.file} type="application/pdf" aria-label={`Anshul Nigam ${currentResume.label} resume`}>
            <div class="resume-fallback-panel">
              <p>Your browser cannot display the resume inline.</p>
              <a class="button button-dark" href={currentResume.file} target="_blank" rel="noreferrer">Open resume <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={currentResume.file} download>Download PDF <span aria-hidden="true">↓</span></a>
            </div>
          </object>
        </div>
        <div class="resume-links">
          {resumes.map((resume) => (
            <div class="resume-link-group">
              <a class="text-link resume-fallback" href={resume.file} target="_blank" rel="noreferrer">
                Open {resume.label} resume <span aria-hidden="true">↗</span>
              </a>
              <a class="resume-download-link" href={resume.file} download>Download</a>
            </div>
          ))}
        </div>
      </section>

      <section class="contact-section section-wrap" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="eyebrow">Have a good problem? <span class="section-number">05</span></p>
          <h2 id="contact-title">Let's make something useful.</h2>
          <p>For thoughtful collaborations, AI engineering roles or a good conversation about building with AI.</p>
        </div>
        <div class="contact-actions">
          <a class="button button-light" href="mailto:anshulnigam123@gmail.com">Contact me <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/anshul13j/" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Anshul-13J" target="_blank" rel="noreferrer">Browse GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer section-wrap">
      <a class="wordmark" href="#home"><span class="wordmark-mark">AN</span><span>Anshul Nigam</span></a>
      <p>Vibe coded with curiosity. Built with Astro.</p>
      <a href="#home">Back to top ↑</a>
      <span>© {new Date().getFullYear()} Anshul Nigam</span>
    </footer>

    <button class="dev-mode-launcher" type="button" aria-haspopup="dialog" aria-controls="dev-terminal">
      <span class="launcher-prompt" aria-hidden="true">&gt;_</span> Try dev mode
    </button>
    <dialog class="terminal-dialog" id="dev-terminal" aria-labelledby="terminal-title" data-resume={currentResume.file}>
      <div class="terminal-window">
        <header class="terminal-titlebar">
          <div>
            <span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span id="terminal-title">anshul@portfolio: ~</span>
          </div>
          <button class="terminal-close" type="button" aria-label="Close dev mode">×</button>
        </header>
        <div class="terminal-intro">
          <p class="terminal-brand">Anshul Nigam <span>Developer mode</span></p>
          <p>Portfolio CLI · Interactive profile</p>
          <p>Session ready. Read-only navigation only. No shell commands run.</p>
          <p>Type <code>help</code> to see what you can do.</p>
        </div>
        <div class="terminal-output" role="log" aria-live="polite" aria-relevant="additions text"></div>
        <form class="terminal-form">
          <label for="terminal-input"><span aria-hidden="true">anshul@portfolio:~$</span><span class="visually-hidden">Enter a command</span></label>
          <input id="terminal-input" name="command" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Terminal command" />
        </form>
        <div class="terminal-hints" aria-label="Command examples">
          <button type="button" data-command="projects">projects</button>
          <button type="button" data-command="resume">resume</button>
          <button type="button" data-command="contact">contact</button>
          <button type="button" data-command="help">help</button>
        </div>
      </div>
    </dialog>

    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const siteNav = document.querySelector("#site-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        siteNav?.classList.toggle("is-open", !isOpen);
      });

      siteNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle?.setAttribute("aria-expanded", "false");
          siteNav.classList.remove("is-open");
        });
      });

      document.querySelectorAll("[data-filter]").forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.getAttribute("data-filter");
          document.querySelectorAll("[data-filter]").forEach((filterButton) => {
            const active = filterButton === button;
            filterButton.classList.toggle("is-active", active);
            filterButton.setAttribute("aria-pressed", String(active));
          });
          document.querySelectorAll(".project-card").forEach((card) => {
            card.hidden = filter !== "all" && card.getAttribute("data-category") !== filter;
          });
          projectGrid?.scrollTo({ left: 0, behavior: "smooth" });
          updateProjectControls();
        });
      });

      const projectGrid = document.querySelector("#project-grid");
      const previousProjects = document.querySelector("[data-project-prev]");
      const nextProjects = document.querySelector("[data-project-next]");
      const projectPosition = document.querySelector(".project-position");
      const projectCards = [...document.querySelectorAll(".project-card")];

      const updateProjectControls = () => {
        if (!projectGrid) return;
        const visibleCards = projectCards.filter((card) => !card.hidden);
        const maxScroll = projectGrid.scrollWidth - projectGrid.clientWidth;
        const atStart = projectGrid.scrollLeft <= 2;
        const atEnd = projectGrid.scrollLeft >= maxScroll - 2;
        if (previousProjects instanceof HTMLButtonElement) previousProjects.disabled = atStart;
        if (nextProjects instanceof HTMLButtonElement) nextProjects.disabled = atEnd;
        const gridLeft = projectGrid.getBoundingClientRect().left;
        const currentCard = visibleCards.findIndex((card) => card.getBoundingClientRect().right > gridLeft + 2);
        const position = Math.max(0, currentCard);
        if (projectPosition) {
          projectPosition.textContent = `${String(Math.min(position + 1, visibleCards.length)).padStart(2, "0")} / ${String(visibleCards.length).padStart(2, "0")}`;
        }
      };

      const moveProjects = (direction) => {
        const card = projectGrid?.querySelector(".project-card:not([hidden])");
        if (!projectGrid || !card) return;
        const gap = Number.parseFloat(getComputedStyle(projectGrid).columnGap) || 0;
        projectGrid.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: "smooth" });
      };

      previousProjects?.addEventListener("click", () => moveProjects(-1));
      nextProjects?.addEventListener("click", () => moveProjects(1));
      projectGrid?.addEventListener("scroll", updateProjectControls, { passive: true });
      window.addEventListener("resize", updateProjectControls);
      updateProjectControls();

      const terminalDialog = document.querySelector("#dev-terminal");
      const terminalLauncher = document.querySelector(".dev-mode-launcher");
      const terminalClose = document.querySelector(".terminal-close");
      const terminalForm = document.querySelector(".terminal-form");
      const terminalInput = document.querySelector("#terminal-input");
      const terminalOutput = document.querySelector(".terminal-output");
      const terminalHistory = [];
      let historyIndex = 0;
      const resumeFile = terminalDialog?.getAttribute("data-resume") ?? "/resume.pdf";

      const addTerminalLine = (content, type = "response") => {
        const line = document.createElement("p");
        line.className = `terminal-line terminal-line-${type}`;
        if (content instanceof Node) {
          line.append(content);
        } else {
          line.textContent = content;
        }
        terminalOutput?.append(line);
        if (terminalOutput) terminalOutput.scrollTop = terminalOutput.scrollHeight;
      };

      const commandLink = (label, href, download = false) => {
        const link = document.createElement("a");
        link.href = href;
        link.textContent = label;
        if (download) link.download = "";
        if (!download && !href.startsWith("mailto:")) {
          link.target = "_blank";
          link.rel = "noreferrer";
        }
        return link;
      };

      const runCommand = (rawCommand) => {
        const command = rawCommand.trim();
        if (!command) return;
        addTerminalLine(`anshul@portfolio:~$ ${command}`, "command");
        terminalHistory.push(command);
        historyIndex = terminalHistory.length;
        const [action, ...argumentsList] = command.toLowerCase().split(/\s+/);

        switch (action) {
          case "help":
            addTerminalLine("help              Show available commands");
            addTerminalLine("projects          List featured projects");
            addTerminalLine("project <name>    Jump to a project card");
            addTerminalLine("resume            Download the latest resume");
            addTerminalLine("contact           Start an email");
            addTerminalLine("github | linkedin Open a profile");
            addTerminalLine("about             Jump to the about section");
            addTerminalLine("clear             Clear this terminal");
            addTerminalLine("exit              Close developer mode");
            break;
          case "projects":
            document.querySelectorAll(".project-card").forEach((card) => {
              addTerminalLine(`• ${card.getAttribute("data-project-name")}`);
            });
            break;
          case "project": {
            const query = argumentsList.join(" ");
            const project = [...document.querySelectorAll(".project-card")].find((card) =>
              card.getAttribute("data-project-name")?.includes(query),
            );
            if (project && query) {
              project.scrollIntoView({ behavior: "smooth", block: "center" });
              addTerminalLine(`Opening ${project.querySelector("h3")?.textContent ?? "project"} in the portfolio.`);
              terminalDialog?.close();
            } else {
              addTerminalLine("Project not found. Run projects to see available names.", "error");
            }
            break;
          }
          case "resume":
            addTerminalLine(commandLink("Download the latest resume", resumeFile, true));
            break;
          case "contact":
          case "email":
            addTerminalLine(commandLink("Email Anshul", "mailto:anshulnigam123@gmail.com"));
            break;
          case "github":
            addTerminalLine(commandLink("Open GitHub", "https://github.com/Anshul-13J"));
            break;
          case "linkedin":
            addTerminalLine(commandLink("Open LinkedIn", "https://www.linkedin.com/in/anshul13j/"));
            break;
          case "about":
            terminalDialog?.close();
            document.querySelector("#about")?.scrollIntoView({ behavior: "smooth" });
            break;
          case "clear":
            if (terminalOutput) terminalOutput.replaceChildren();
            break;
          case "exit":
            terminalDialog?.close();
            break;
          default:
            addTerminalLine(`Command not found: ${action}. Type help to see available commands.`, "error");
        }
      };

      terminalLauncher?.addEventListener("click", () => {
        terminalDialog?.showModal();
        terminalInput?.focus();
      });
      terminalClose?.addEventListener("click", () => terminalDialog?.close());
      terminalDialog?.addEventListener("click", (event) => {
        if (event.target === terminalDialog) terminalDialog.close();
      });
      terminalDialog?.addEventListener("close", () => terminalLauncher?.focus());
      terminalForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        runCommand(terminalInput?.value ?? "");
        if (terminalInput) terminalInput.value = "";
      });
      terminalInput?.addEventListener("keydown", (event) => {
        if (event.key === "ArrowUp" && terminalInput) {
          event.preventDefault();
          historyIndex = Math.max(0, historyIndex - 1);
          terminalInput.value = terminalHistory[historyIndex] ?? "";
        }
        if (event.key === "ArrowDown" && terminalInput) {
          event.preventDefault();
          historyIndex = Math.min(terminalHistory.length, historyIndex + 1);
          terminalInput.value = terminalHistory[historyIndex] ?? "";
        }
      });
      document.querySelectorAll("[data-command]").forEach((button) => {
        button.addEventListener("click", () => {
          const command = button.getAttribute("data-command") ?? "";
          if (terminalInput) terminalInput.value = command;
          runCommand(command);
          if (terminalInput) terminalInput.value = "";
          terminalInput?.focus();
        });
      });
    </script>
  </body>
</html>
